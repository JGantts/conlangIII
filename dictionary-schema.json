{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "lexeme": {
          "type": "string"
        },
        "simple": {
          "type": "string"
        },
        "defs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "object",
                "oneOf": [
                  {
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "noun"
                      },
                      "class": {
                        "type": "string",
                        "enum": ["chaos", "life", "order", "death"]
                      }
                    },
                    "required": ["type", "class"],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "verb"
                      }
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                ]
              },
              "def": {
                "type": "string"
              },
              "ex": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ex": {
                      "type": "string"
                    },
                    "glossI": {
                      "type": "string"
                    },
                    "glossII": {
                      "type": "string"
                    },
                    "eng": {
                      "type": "string"
                    }
                  },
                  "required": ["ex", "eng"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type", "def"],
            "additionalProperties": false
          }
        }
      },
      "required": ["lexeme", "simple", "defs"],
      "additionalProperties": false
    }
  }
  